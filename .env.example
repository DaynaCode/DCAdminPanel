# =============================================================================
# .env.example — environment variables for docker-compose
# =============================================================================
# Copy this file to `.env` and edit the values for your deployment.
#
#   cp .env.example .env
#   nano .env
#
# IMPORTANT: Never commit the real .env file to git!
# =============================================================================

# ---------- Django core ----------
# Generate a secure secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=please_change_this_to_a_random_50_char_string

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Django settings module (use example.settings for the test server,
# or your_project.settings.production for production)
DJANGO_SETTINGS_MODULE=example.settings

# ---------- Database (PostgreSQL) ----------
DB_NAME=dcadmin
DB_USER=dcadmin
DB_PASSWORD=change_me_to_a_secure_password
# DB_HOST=db  (when using docker-compose, the service name "db" works)
# DB_PORT=5432

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- i18n / Localization ----------
# Default language: "fa" for Persian (RTL), "en" for English (LTR)
LANGUAGE_CODE=fa

# Default timezone (Asia/Tehran for Iran, UTC for global)
TIME_ZONE=Asia/Tehran

# ---------- Web server ----------
# Port to expose on the host (8080 to avoid conflicts with other dev servers)
WEB_PORT=8080

# ---------- Email (optional, for error notifications & password reset) ----------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ---------- Sentry (optional, for error tracking) ----------
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/your_project_id

# ---------- CDN / S3 (optional, for static/media file hosting) ----------
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=your_bucket
# AWS_S3_REGION_NAME=eu-west-1
# AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com
